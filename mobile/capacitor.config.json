{
  "appId": "com.dtera.tally",
  "appName": "Tally",
  "webDir": "www",
  "backgroundColor": "#1b1d21",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never", "scrollEnabled": true },
